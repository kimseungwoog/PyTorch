# 복사해서 .env 로 저장한 뒤 값을 채운다. .env 는 git 에 올라가지 않는다.

# 서버
PORT=8787
HOST=127.0.0.1

# 모의투자
PAPER_INITIAL_CASH=10000000
FEE_RATE=0.00015
SELL_TAX_RATE=0.0015
MAX_ORDER_AMOUNT=5000000
# 하루 손실 한도(원). 오늘 시작 자산보다 이만큼 줄면 매수를 막는다. 화면에서도 바꿀 수 있다.
DAILY_LOSS_LIMIT=300000

# 키움 REST API (openapi.kiwoom.com 에서 신청·발급, 허용 IP 등록 필요)
# "Open API+"나 "해외파생 OpenAPI-W"의 키가 아니다. 그 둘은 윈도우 OCX 방식이라 이 앱에서 쓸 수 없다.
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
# true = 모의투자 서버, false = 실전 서버. 키를 발급받은 쪽과 맞춰야 한다.
KIWOOM_MOCK=true

# 토스증권 Open API (나중에 주문용으로 붙일 때) (WTS > 설정 > Open API 에서 발급, 허용 IP 등록 필요)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT=

# 새 글 알림: X 공식 API 토큰 (developer.x.com 에서 발급, 요금제에 따라 유료). 비우면 X 는 자동 확인을 하지 않는다.
X_BEARER_TOKEN=
